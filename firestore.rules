rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'friendCode', 'gradeYear', 'targetSession', 'xp', 'level', 'streak', 'weeklyFocusMinutes', 'status', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'friendCode', 'gradeYear', 'targetSession', 'xp', 'level', 'streak', 'weeklyFocusMinutes', 'status', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 40
        && data.friendCode is string && data.friendCode.size() == 5 && data.friendCode.matches('^[0-9]{5}$')
        && data.gradeYear is string && data.gradeYear.size() <= 40
        && data.targetSession is string && data.targetSession.size() <= 40
        && data.xp is int && data.xp >= 0
        && data.level is int && data.level >= 1
        && data.streak is int && data.streak >= 0
        && data.weeklyFocusMinutes is int && data.weeklyFocusMinutes >= 0
        && data.status is string && data.status in ['Studying ⚡', 'Online', 'Resting']
        && data.updatedAt == request.time;
    }

    function isValidUserWorkspace(data) {
      return data.keys().hasAll(['ownerId', 'payloadJson', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'payloadJson', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.payloadJson is string && data.payloadJson.size() <= 500000
        && data.updatedAt == request.time;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['fromUid', 'fromName', 'fromCode', 'toUid', 'toCode', 'status', 'createdAt'])
        && data.keys().hasOnly(['fromUid', 'fromName', 'fromCode', 'toUid', 'toCode', 'status', 'createdAt'])
        && data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128
        && data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 80
        && data.fromCode is string && data.fromCode.size() == 5 && data.fromCode.matches('^[0-9]{5}$')
        && data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128
        && data.toCode is string && data.toCode.size() == 5 && data.toCode.matches('^[0-9]{5}$')
        && data.status is string && data.status in ['pending', 'accepted', 'declined']
        && data.createdAt is timestamp;
    }

    function isValidStudyRoom(data) {
      return data.keys().hasAll(['roomCode', 'name', 'subject', 'weeklyTargetMinutes', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['roomCode', 'name', 'subject', 'weeklyTargetMinutes', 'ownerId', 'createdAt'])
        && data.roomCode is string && data.roomCode.size() == 5 && data.roomCode.matches('^[0-9]{5}$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.subject is string && data.subject.size() <= 60
        && data.weeklyTargetMinutes is int && data.weeklyTargetMinutes >= 60 && data.weeklyTargetMinutes <= 10000
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.createdAt is timestamp;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.friendCode is string;
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUserProfile(incoming());
      allow update: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().friendCode == existing().friendCode
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'gradeYear', 'targetSession', 'xp', 'level', 'streak', 'weeklyFocusMinutes', 'status', 'updatedAt']);
    }

    match /workspaces/{userId} {
      allow get: if isVerified() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUserWorkspace(incoming());
      allow update: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUserWorkspace(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly(['payloadJson', 'updatedAt']);
    }

    match /friendRequests/{requestId} {
      allow get: if isVerified() && isValidId(requestId) && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if isVerified() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isVerified() && isValidId(requestId) && isValidFriendRequest(incoming())
        && incoming().fromUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(incoming().toUid));
      allow update: if isVerified() && isValidId(requestId) && isValidFriendRequest(incoming())
        && existing().status == 'pending'
        && existing().toUid == request.auth.uid
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().createdAt == existing().createdAt
        && incoming().status in ['accepted', 'declined']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    match /studyRooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && resource.data.roomCode is string;
      allow create: if isVerified() && isValidId(roomId) && isValidStudyRoom(incoming())
        && incoming().createdAt == request.time;
      allow update: if isVerified() && isValidId(roomId) && isValidStudyRoom(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().roomCode == existing().roomCode
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'subject', 'weeklyTargetMinutes']);
    }
  }
}
